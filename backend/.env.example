PORT=5000
JWT_SECRET=thay_bang_chuoi_bi_mat_cua_ban
# Google Gemini API key (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_gemini_api_key
# (Tuỳ chọn) Nhiều key cùng lúc, cách nhau dấu phẩy — hệ thống tự đổi key khi 1 key hết lượt.
# Cũng có thể thêm key ở trang Admin → AI chấm bài (không cần sửa file này).
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=your_google_gemini_api_key
FRONTEND_URL=http://localhost:5173

# ── Lịch chấm gom AI (tiết kiệm lượt gọi/ngày) ─────────────────
# daily = gom bài, chấm mỗi tối + trước hạn nộp; immediate = chấm ngay từng bài khi nộp
GRADING_SCHEDULE=daily
GRADING_DAILY_TIME=21:30
# Chấm thêm 1 đợt trước hạn nộp bao nhiêu phút
GRADING_PREDUE_MINUTES=60
# Số học sinh chấm chung 1 lượt gọi AI
GRADING_GROUP_SIZE=3
# Giáo viên nộp hộ: chấm gom sau bao nhiêu phút kể từ lần nộp hộ cuối
GRADING_TEACHER_DELAY_MIN=2
# Chấm song song: mỗi key gánh tối đa bao nhiêu nhóm cùng lúc / tổng số nhóm chạy cùng lúc
GRADING_PARALLEL_PER_KEY=2
GRADING_MAX_PARALLEL=6
